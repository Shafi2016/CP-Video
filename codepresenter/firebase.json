{
  "hosting": {
    "public": "dist/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|woff|woff2|ttf|png|jpg|jpeg|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "jupyter-server-launcher",
          "region": "us-central1"
        }
      },
      {
        "source": "/uploads/**",
        "run": {
          "serviceId": "jupyter-server-launcher",
          "region": "us-central1"
        }
      },
      {
        "source": "/render/export",
        "run": {
          "serviceId": "jupyter-server-launcher",
          "region": "us-central1"
        }
      },
      {
        "source": "/render-mode/**",
        "run": {
          "serviceId": "jupyter-server-launcher",
          "region": "us-central1"
        }
      },
      {
        "source": "/render-mode",
        "run": {
          "serviceId": "jupyter-server-launcher",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
