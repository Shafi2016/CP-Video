# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Gemma 4 teaching model provider for Python video narration.
# google-gemma uses hosted Gemma 4 through the Gemini API.
# ollama-gemma uses a local Ollama server.
# auto tries Google first, then local Ollama if configured.
AI_PROVIDER=google-gemma
GEMMA_MODEL=gemma-4-31b-it
# Optional comma-separated cloud model menu shown in the export UI.
GEMMA_MODELS=gemma-4-31b-it
GOOGLE_API_KEY=your_google_ai_studio_key_here
# GOOGLE_API_KEY_FILE=.keys/GOOGLE_API_KEY
# Or keep the key in the existing sibling keys/.env as GOOGLE_API_KEY,
# GEMINI_API_KEY, or GEMINI_GEMMA_API_KEY.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default local model if the UI does not send one.
OLLAMA_MODEL=gemma4:e2b
# Comma-separated local Ollama models shown in the export UI.
# Pull any models you want to use first, for example:
# ollama pull gemma4:e2b
# ollama pull gemma4:e4b
OLLAMA_MODELS=gemma4:e2b,gemma4:e4b,gemma4

# OpenAI API Key (Required for TTS voice generation and legacy AI flows)
OPENAI_API_KEY=your_openai_api_key_here

# Access Code for Application
ACCESS_CODE=your_access_code_here

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Backend)
FIREBASE_PROJECT_ID=your_project_id

# Database Configuration
# DATABASE_URL=postgres://user:password@localhost:5432/dbname

# Server Configuration
PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# Jupyter Configuration
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JUPYTER_TOKEN=your_secure_jupyter_token_here
JUPYTER_PORT=8888

# Cloud Run Configuration
ENABLE_LANGCHAIN_AGENTS=true
ENABLE_VISUAL_LEARNING=false
SERVE_STATIC=true

# CodePresenter Base URL (for dev/prod environment)
CODEPRESENTER_BASE_URL=http://localhost:8080
VITE_CODEPRESENTER_WS_URL=

# Jupyter Execution Timeout Configuration (for long-running operations like agents)
# Overall execution timeout in milliseconds (default: 60 minutes)
EXECUTION_TIMEOUT_MS=3600000
# Subprocess timeout in milliseconds (default: slightly less than EXECUTION_TIMEOUT_MS)
SUBPROCESS_TIMEOUT_MS=3570000
# Gateway WebSocket execution timeout in milliseconds (default: EXECUTION_TIMEOUT_MS)
JUPYTER_WS_TIMEOUT_MS=3600000
# IOPub message timeout in seconds (default: 15 minutes between kernel messages)
IOPUB_MESSAGE_TIMEOUT_SEC=900
# Network operation timeout for WebSearchTool and similar tools (seconds: 30 minutes)
NETWORK_TOOL_TIMEOUT_SEC=1800

# Frontend notebook execution timeout in milliseconds (Vite env; default: 30 minutes)
VITE_JUPYTER_EXECUTION_TIMEOUT_MS=1800000
